# PostgreSQL — used by the compose stack and by CLI scripts (via dotenv).
# The app constructs DATABASE_URL from these at runtime; see docker-compose.yml.
POSTGRES_DB=fritter_post
POSTGRES_USER=fritter_post
POSTGRES_PASSWORD=

# For local development outside Docker, set DATABASE_URL directly instead:
# DATABASE_URL=postgresql://fritter_post:password@localhost:5432/fritter_post

# LLM — three provider credential pairs. Each stage picks one with `provider:`
# in config/models.yaml; `ollama-cloud` is the default and uses LLM_*.
LLM_BASE_URL=https://your-ollama-cloud-endpoint/v1
LLM_API_KEY=your-api-key

# provider: nanogpt
NANOGPT_BASE_URL=https://nano-gpt.com/api/v1
NANOGPT_API_KEY=your-api-key

# provider: openrouter. **Required, not optional**: the embedding model
# (qwen/qwen3-embedding-8b) runs here, and the grouping stage cannot cluster
# without it — a deploy missing this fails at grouping rather than at startup.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your-api-key

# The reader's local day, which decides what date a paper is published under and
# what hour the daily timer means. A run starting at 7pm Pacific must not publish
# tomorrow's edition. Defaults to America/Los_Angeles if unset.
PAPER_TIMEZONE=America/Los_Angeles

# Node environment
NODE_ENV=development
